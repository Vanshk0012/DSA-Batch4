        int low = 1;
        int high = 0;

        for (int i = 0; i < piles.length; i++) {
            if (piles[i] > high) {
                high = piles[i];
            }
        }

       
        while (low<high) {

            int mid = (low + high) / 2;

            if (khaPayega(piles, h, mid)) {
                high = mid;        
            } else {
                low = mid + 1;     
            }
        }

        return low;   
    }

    public boolean khaPayega(int[] piles, int h, int mid) {

        int Total_time = 0;

        for (int i = 0; i < piles.length; i++) {

            
            int hours = piles[i] / mid;

            if (piles[i] % mid != 0) {
                hours = hours + 1;
            }

            Total_time = Total_time + hours;
        }

        if (Total_time <= h) {
            return true;
        } else {
            return false;
        }
    }
